{
  "routes": [
    {
      "src": "/api/ping-africa/(.*)",
      "dest": "https://bulk.ping.africa/api/$1"
    },
    {
      "src": "/api/proxy-logo",
      "dest": "https://school.ngaosports.com/media/school_logos/Screenshot_2026-01-24_08_17_15_PlOmrtG.png"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://school.ngaosports.com/api/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "https://school.ngaosports.com/media/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
